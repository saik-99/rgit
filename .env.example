# Environment Variables Example for UrbanIncident Fusion
# Copy to .env and configure local keys. NEVER commit actual keys to Git.

# NASA FIRMS API Map Key (optional - get key at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Weather API toggles (Open-Meteo does not require a key; fallback is synthetic)
USE_LIVE_WEATHER=true

# Optional Google Flood API Key
GOOGLE_FLOOD_API_KEY=

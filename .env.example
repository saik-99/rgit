# ==============================================================================
# Urban Incident Fusion & Causal Intelligence - Environment Configuration
# ==============================================================================
# All keys below are optional. The application runs fully with none of them set,
# utilizing official web fallbacks and free public data feeds (USGS & Open-Meteo).

# 1. Windy Map Forecast API Key (Optional)
# Get a key from: https://api.windy.com/keys
# If set: loads the official Windy Leaflet plugin with synchronized animated layers.
# If unset: uses the official Windy iframe embed centered on Mumbai.
WINDY_MAP_API_KEY=

# 2. Google Flood Forecasting API Key (Optional)
# Request access at: https://developers.google.com/flood-forecasting
# If set: fetches upstream river risk gauge forecasts (cached 15 minutes).
# If unset: provides direct links to the official Google Flood Hub map portal.
GOOGLE_FLOOD_API_KEY=

# 3. USGS Earthquake GeoJSON Feed URL (Optional)
# Default: https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson
